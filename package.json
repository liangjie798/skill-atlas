{
  "name": "skill-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @skill-atlas/desktop dev",
    "dev:website": "pnpm --filter @skill-atlas/website dev",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @skill-atlas/desktop build",
    "build:website": "pnpm --filter @skill-atlas/website build",
    "tauri": "pnpm --filter @skill-atlas/desktop tauri",
    "tauri:dev": "pnpm --filter @skill-atlas/desktop tauri:dev",
    "tauri:build": "pnpm --filter @skill-atlas/desktop tauri:build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.1"
  }
}
