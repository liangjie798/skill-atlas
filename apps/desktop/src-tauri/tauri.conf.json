{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Atlas",
  "version": "0.2.0",
  "identifier": "io.github.liangjie798.skillatlas",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Skill Atlas",
      "width": 1280,
      "height": 800,
      "minWidth": 980,
      "minHeight": 640,
      "center": true,
      "resizable": true
    }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "只读盘点本机 Agent Skills",
    "longDescription": "Skill Atlas 扫描、归并、分类并检查本机 Agent Skill，不修改任何 Skill 文件。",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
